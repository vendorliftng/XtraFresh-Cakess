{
  // ⚠️ "name" MUST match your existing Cloudflare project name exactly.
  // Find it: Cloudflare dashboard → Workers & Pages → the project title.
  // If it differs, Cloudflare creates a SECOND worker and your domain
  // keeps pointing at the old, broken one.
  "name": "xtrafresh-cakess",

  // Matches what the dashboard already had, so nothing else changes.
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    // Serve the repository root as plain static files.
    "directory": "./",

    // Leave html_handling at its default ("auto-trailing-slash").
    //
    // Do NOT set it to "none": that serves files only at their exact paths,
    // which means "/" stops resolving to index.html and the bare domain
    // returns a 404. The default is what makes xtrafreshcakes.com work.
    //
    // The default also serves /store.html at /store. The canonical tags and
    // sitemap point at /store to match.

    // "404-page" = if a file genuinely does not exist, show 404.html.
    //
    // The default is "single-page-application", which returns index.html
    // with a 200 OK for EVERY unmatched path. That is why store.html,
    // og-image.jpg, robots.txt and sitemap.xml were all returning the
    // homepage — and why WhatsApp could not build a link preview, since
    // og-image.jpg was answering with HTML instead of an image.
    "not_found_handling": "404-page"
  }
}
